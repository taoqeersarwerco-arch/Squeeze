# Google AdSense
# Leave empty / unset to keep ad units completely disabled in the UI (no placeholders or layout shift).
# When your AdSense account is approved, set this to your publisher client ID (e.g. ca-pub-1234567890123456)
# to automatically enable the AdSense script and banner components.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google Search Console Verification (HTML tag method)
# Set your verification code token here if not using DNS TXT record verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

